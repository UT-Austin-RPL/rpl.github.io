---
layout: null
permalink: /search.json
---
[
  {% assign publications = site.posts | where_exp: "post", "post.path contains 'publications/'" %}
  {% for post in publications %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.external_url | default: post.url | relative_url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
